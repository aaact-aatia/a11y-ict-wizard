# ==============================================================================
# A11y ICT Wizard - Environment Configuration Sample
# ==============================================================================
# Copy this file to .env and configure for your environment:
#   cp .env.sample .env
#
# For Docker Compose (local development):
#   - Use the LOCAL DOCKER SETUP section below
#   - Run: docker compose up
#
# For remote database connections:
#   - Comment out LOCAL DOCKER SETUP section
#   - Uncomment the REMOTE DATABASE section
#   - Run: npm run devstart
# ==============================================================================

# Application Configuration
PORT=3001
EN_VERSION="EN 301 549 V4.1.1 (2025) - Development"

# GitHub OAuth (optional - for login features)
# Note: These are typically configured in Azure Application Settings or GitHub Actions secrets
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# CMS Authentication (for /edit routes)
BASICAUTHUSERNAME=admin
BASICAUTHPASSWORD=change-this-password-in-production

# Session Secret (change in production)
SESSION_SECRET=change-this-secret-in-production

# ==============================================================================
# LOCAL DOCKER SETUP (Default)
# ==============================================================================
# Use these settings when running with docker compose
# The 'mongo' hostname refers to the MongoDB service in docker-compose.yml

DBURI=mongodb://mongo:27017/a11y-req-dev-2025
WAITFORMONGO=true
WAITHOSTS=mongo:27017
DB_NAME=a11y-req-dev-2025

# ==============================================================================
# REMOTE DATABASE (Optional)
# ==============================================================================
# To connect to a remote MongoDB instead of Docker:
# 1. Comment out the LOCAL DOCKER SETUP section above
# 2. Uncomment and configure the settings below with your MongoDB connection details
# 3. Run: npm run devstart (Docker not needed)
#
# Supports: MongoDB Atlas, Azure Cosmos DB, or any MongoDB-compatible service
# Connection string format examples:
#   MongoDB Atlas:  mongodb+srv://username:password@cluster.mongodb.net/database?options
#   Azure Cosmos:   mongodb://username:password@host.cosmos.azure.com:10255/database?ssl=true&options
#   Standard:       mongodb://username:password@host:27017/database

# DBURI=mongodb+srv://username:password@your-cluster.mongodb.net/a11y-req-dev-2025?retryWrites=true&w=majority
# DB_NAME=a11y-req-dev-2025
# WAITFORMONGO=true
# BASICAUTHUSERNAME=your_username
# BASICAUTHPASSWORD=your_password

