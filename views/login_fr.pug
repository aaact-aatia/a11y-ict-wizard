extends layout_fr

block content
  h1#wb-cont(property="name")= title
  
  if error
    .alert.alert-danger(role="alert")
      h2.h3 Erreur
      p= error
  
  form.form-horizontal(method="POST" action="/fr/edit/login")
    fieldset
      legend Accéder au système de gestion de contenu
      
      .form-group
        label.col-sm-3.control-label(for="username")
          | Nom d'utilisateur
          span.required(aria-hidden="true")  (obligatoire)
        .col-sm-9
          input#username.form-control(
            type="text" 
            name="username" 
            required
            aria-required="true"
            autocomplete="username"
          )
      
      .form-group
        label.col-sm-3.control-label(for="password")
          | Mot de passe
          span.required(aria-hidden="true")  (obligatoire)
        .col-sm-9
          input#password.form-control(
            type="password" 
            name="password" 
            required
            aria-required="true"
            autocomplete="current-password"
          )
      
      .form-group
        .col-sm-offset-3.col-sm-9
          button.btn.btn-primary(type="submit")
            | Connexion
          |  
  p
	a(href="/fr") Retour à l'assistant
