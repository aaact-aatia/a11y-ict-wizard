//- Functions to generate clause tree

mixin fpsCheckbox(clause, selected, endNode)
  .checkbox
    if endNode
      svg.info-icon(width="24" height="24" viewBox="-10 -10 80 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false")
        path(d="M24 16V24M24 32H24.02M44 24C44 35.0457 35.0457 44 24 44C12.9543 44 4 35.0457 4 24C4 12.9543 12.9543 4 24 4C35.0457 4 44 12.9543 44 24Z" stroke="#2239ab" stroke-width="4" stroke-linecap="round" stroke-linejoin="round")
    else
      i.expand
      i.collapse
    label(for=clause.id)
      input.read-only(id=clause.id type='checkbox' name='clauses' data-number=clause.number value=clause.id class=clause.informative ? 'informative' : '' checked=selected tabindex='-1' aria-hidden='true')
      span.remove-text
      span.number #{clause.number} 
      span.name #{clause.name}
    if endNode
      .detail-inner
        | !{clause.description}

mixin createTree(tree)
  each clauseNode in tree
    -var selected = itemExists && item.clauses.indexOf(clauseNode.clause.id) > -1 ? 'checked' : false
    if clauseNode.children.length === 0
      //- Add aria-checked properties via javascript (need to check for mixed state)
      li.endNode(role='treeitem' class=clauseNode.clause.informative ? 'informative' : '' aria-expanded='false')
        +fpsCheckbox(clauseNode.clause, selected, true)
    else
      li.parentNode(role='treeitem' aria-expanded='false')
        //- Should parent checkboxes have aria-controls attribute?
        +fpsCheckbox(clauseNode.clause, selected, false)
        ul(role='group')
          +createTree(clauseNode.children)

//- Passed argument is tree-like JS object 'clause_tree'
//- See /controllers/clauseTree.js for details

fieldset#clauses
  legend
    span#tree_label.field-name #{tree_name}
  .btn-group
    button.btn.btn-default#expandTree Expand tree
    button.btn.btn-default#expandAll(style="margin-left : 3px") Expand all
    button.btn.btn-default#collapseAll(style="margin-left : 3px") Collapse all
  .btn-group(style="margin-left : 10px")
    button.btn.btn-default#showAllRemovedClauses Show removed
    button.btn.btn-default#hideAllRemovedClauses(style="margin-left : 3px") Hide removed
  //- aria-labelledby is not be necessary due to the fieldset legend
  //- aria-multiselectable='false' indicates this is a single-selection tree
  //- treeitems use aria-checked property rather than aria-selected (to express 'mixed' state)
  ul.clause-tree(role='tree' aria-multiselectable='false')
    +createTree(clause_tree)
  div.wb-inv(aria-live="polite")
    p.disabledClauses.hidden Nothing disabled