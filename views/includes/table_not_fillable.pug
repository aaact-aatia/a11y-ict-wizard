if item_list.length > 0
  table.table.table-bordered(alt='Table of EN 301 549 requirements')
    thead
      tr.active
        th.col-sm-6(scope='col') EN 301 549 clause
    tbody
      each item in item_list
        tr
          td(valign='top')
            p
              strong
                if item.clauseLinkId
                  a(id=item.clauseLinkId name=item.clauseLinkId tabindex='-1' style='color: black; text-decoration: none;') #{item.number} #{item.name}
                else
                  | #{item.number} #{item.name}
            | !{item.description}
            if item.compliance.length > 0
              p
                strong Relationship between requirements and functional performance criteria:
                | !{item.compliance}
else
  p No clauses included