-var i = 0

mixin checkbox(label, name, onlyIf, descri, isUber, isUnique)
  if name === undefined
    -name = 'checkbox' + i++
  - var descri = description
  .checkbox(class=`checkbox-${name}`)
    label(for=name)
      input(id=name type='checkbox' name=name class=(onlyIf ? 'onlyIf' : false) class=(isUber ? 'isUber' : false) class=(isUnique ? 'isUnique' : false))
      span.remove-disabled-text.hidden [Supprimé par une autre sélection]!{' '}
      | !{label}
    a(href=`#moreInfo${name}` aria-controls=`moreInfo${name}` class="overlay-lnk" aria-label=`Ouvrir un dialogue avec plus d'information sur ${label}` role="button")
      svg(width="24.1" height="24.1" viewBox="-10 -10 80 80" fill="none" xmlns="http://www.w3.org/2000/svg" style="position: absolute; transform: translate(0%, 10%)")
        path(d="M24 16V24M24 32H24.02M44 24C44 35.0457 35.0457 44 24 44C12.9543 44 4 35.0457 4 24C4 12.9543 12.9543 4 24 4C35.0457 4 44 12.9543 44 24Z" stroke="#2239ab" stroke-width="4" stroke-linecap="round" stroke-linejoin="round")

  section.wb-overlay.modal-content.overlay-def.wb-popup-mid(id=`moreInfo${name}` role='dialog')
    header.modal-header
      h2.modal-title
        | Plus d'information sur:
        br
        | '!{label}'
    div.modal-body(id=`dialog-${name}`)
      p Description:
      | !{descri}
      br
      p Le document EN 301 549 contient des hyperliens internes dans le PDF qui ne peuvent être reproduits dans cette boîte de dialogue. Cette boîte de dialogue souligne le texte des hyperliens et ajoute un astérisque* après le texte pour indiquer que le terme est défini ou comporte une référence interne.


section.wizard
  
  fieldset
    legend
      span.field-name Les solutions et/ou services des <abbr title="technologies de l'information et des communications">TIC</abbr>:
    
    - var uberQuestions_list = question_list.step1;
    - var nonUberQuestions_list = question_list.step2;
    - var uniqueQuestions_list = question_list.step3;

    if step == 1
      .btn-group
        button#checkAll1(class="btn btn-default") Tout sélectionner
        button#uncheckAll1(class="btn btn-default" style="margin-left : 3px") Tout désélectionner
      .btn-group(style="margin-left : 15px")
        button#undoLastStep1(class="btn btn-default") Annuler
      .btn-group(style="margin-left : 15px")
      button#toggleAutoHiddenOptionsStep1.toggle-switch(
        type="button"
        role="switch"
        aria-checked="false"
        tabindex="0"
        style="margin-left:10px"
      ) Afficher les énoncés masquées automatiquement
      <br/>
      div(aria-atomic="true" aria-live="polite")
        p.clause-count(style="font-size: 16pt")
          strong Nombre total de clauses: <span class='clauseCount'>0</span>
      div.wizard-questions
        .row
          .col-md-6
            each question, index in uberQuestions_list
              if index <= uberQuestions_list.length/2
                +checkbox(question.frName, question._id, question.onlyIf, question.frDescription, question.isUber, question.isUnique)
          .col-md-6
            each question, index in uberQuestions_list
              if index > uberQuestions_list.length/2
                +checkbox(question.frName, question._id, question.onlyIf, question.frDescription, question.isUber, question.isUnique)
    else if step == 2
      .btn-group
        button#checkAll2(class="btn btn-default") Tout sélectionner
        button#uncheckAll2(class="btn btn-default" style="margin-left : 3px") Tout désélectionner
      .btn-group(style="margin-left : 15px")
        button#undoLastStep2(class="btn btn-default") Annuler
      .btn-group(style="margin-left : 15px")
      button#toggleAutoHiddenOptionsStep2.toggle-switch(
        type="button"
        role="switch"
        aria-checked="false"
        tabindex="0"
        style="margin-left:10px"
      ) Afficher les énoncés masquées automatiquement
      <br/>
      div(aria-atomic="true" aria-live="polite")
        p.clause-count(style="font-size: 16pt")
          strong Nombre total de clauses: <span class='clauseCount'>0</span>
      div.wizard-questions
        .row
          .col-md-6
            each question, index in nonUberQuestions_list
              if index <= nonUberQuestions_list.length/2
                +checkbox(question.frName, question._id, question.onlyIf, question.frDescription, question.isUber, question.isUnique)
          .col-md-6
            each question, index in nonUberQuestions_list
              if index > nonUberQuestions_list.length/2
                +checkbox(question.frName, question._id, question.onlyIf, question.frDescription, question.isUber, question.isUnique)
    else if step == 3
      .btn-group
        button#checkAll3(class="btn btn-default") Tout sélectionner
        button#uncheckAll3(class="btn btn-default" style="margin-left : 3px") Tout désélectionner
      .btn-group(style="margin-left : 15px")
        button#undoLastStep3(class="btn btn-default") Annuler
      .btn-group(style="margin-left : 15px")
      button#toggleAutoHiddenOptionsStep3.toggle-switch(
        type="button"
        role="switch"
        aria-checked="false"
        tabindex="0"
        style="margin-left:10px"
      ) Afficher les énoncés masquées automatiquement
      <br/>
      div(aria-atomic="true" aria-live="polite")
        p.clause-count(style="font-size: 16pt")
          strong Nombre total de clauses: <span class='clauseCount'>0</span>
      div.wizard-questions
        .row
          .col-md-6
            each question, index in uniqueQuestions_list
              if index <= uniqueQuestions_list.length/2
                +checkbox(question.frName, question._id, question.onlyIf, question.frDescription, question.isUber, question.isUnique)
          .col-md-6
            each question, index in uniqueQuestions_list
              if index > uniqueQuestions_list.length/2
                +checkbox(question.frName, question._id, question.onlyIf, question.frDescription, question.isUber, question.isUnique)
    
  //- Hidden elements (for client-side javascript)
  div.wb-inv(aria-live="polite")
    p.hidden(class=`disabledQuestionsHidden${step}`) Les énoncés désactivées sont maintenant masquées.
    p.hidden(class=`disabledQuestionsShown${step}`) Les énoncés désactivées sont maintenant affichées.
    p.autoCheckedAnnounce.hidden Des énoncés ont été cochés automatiquement
    p.autoUncheckedAnnounce.hidden Des énoncés ont été décochés automatiquement
