fieldset.download-links
  legend
    span.field-name Générer les documents
  p
    button.btn.btn-default(type='submit' formaction='download_full_not_fillable_en') Télécharger les exigences en matière d'accessibilité des TIC avec sections informatives  (en anglais)
  p
    button.btn.btn-default(type='submit' formaction='download_full_not_fillable_fr') Télécharger les exigences en matière d'accessibilité des TIC avec sections informatives  (en français)
  p
    button.btn.btn-default(type='submit' formaction='download_evaluation_en') Télécharger la liste des exigences en matière d'accessibilité des TIC pouvant être testées  (en anglais)
  p
    button.btn.btn-default(type='submit' formaction='download_evaluation_fr') Télécharger la liste des exigences en matière d'accessibilité des TIC pouvant être testées  (en français)
.document-properties
  details(open='open')
    summary Propriétés de document
    fieldset
      legend
        span.field-name Orientation de la page
      .radio
        label(for='orientation1')
          input(type='radio' name='orientation' value='portrait' id='orientation1' checked)
          | Portrait
      .radio
        label(for='orientation2')
          input(type='radio' name='orientation' value='landscape' id='orientation2')
          | Paysage
    fieldset
      legend
        span.field-name Format du document
      .radio
        label(for='docxformat')
          input(type='radio' name='format' value='docx' id='docxformat' checked)
          | Microsoft Word (.docx)
      .radio
        label(for='htmlformat')
          input(type='radio' name='format' value='html' id='htmlformat')
          | Fichier HTML téléchargeable (.html)